generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubjectCode {
  MATHEMATICS
  MATHEMATICAL_LITERACY
  PHYSICAL_SCIENCES
  LIFE_SCIENCES
  GEOGRAPHY
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  NUMERIC
  EXPLAIN
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  passwordHash        String
  role                Role                 @default(USER)
  grade               Int                  @default(10)
  isActive            Boolean              @default(true)
  avatarUrl           String?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  examAttempts        ExamAttempt[]
  createdPapers       ExamPaper[]          @relation("CreatedPapers")

  @@index([email])
  @@index([role])
  @@index([grade])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ExamPaper {
  id              String         @id @default(uuid())
  title           String
  description     String
  subject         SubjectCode
  grade           Int
  term            Int            @default(1)
  year            Int            @default(2026)
  durationMinutes Int            @default(45)
  totalMarks      Int            @default(0)
  paperFileUrl    String?
  isPublished     Boolean        @default(true)
  createdById     String?
  createdBy       User?          @relation("CreatedPapers", fields: [createdById], references: [id], onDelete: SetNull)
  questions       ExamQuestion[]
  attempts        ExamAttempt[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([grade])
  @@index([subject])
  @@index([grade, subject])
}

model ExamQuestion {
  id             String          @id @default(uuid())
  examPaperId    String
  examPaper      ExamPaper       @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  questionNumber Int
  topic          String
  type           QuestionType
  prompt         String
  options        String[]
  correctAnswer  String
  rubricKeywords String[]
  explanation    String
  marks          Int             @default(2)
  createdAt      DateTime        @default(now())
  attemptAnswers AttemptAnswer[]

  @@index([examPaperId])
}

model ExamAttempt {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  examPaperId      String
  examPaper        ExamPaper       @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  mode             String          @default("REVISION")
  scoreEarned      Float           @default(0)
  totalMarks       Int             @default(0)
  percentage       Float           @default(0)
  gradeSymbol      String          @default("Level 7 (Distinction)")
  timeSpentSeconds Int             @default(0)
  teacherFeedback  String?
  answers          AttemptAnswer[]
  completedAt      DateTime        @default(now())

  @@index([userId])
  @@index([examPaperId])
}

model AttemptAnswer {
  id              String       @id @default(uuid())
  attemptId       String
  attempt         ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswer   String
  marksEarned     Float        @default(0)
  maxMarks        Int          @default(1)
  isCorrect       Boolean      @default(false)
  isPartial       Boolean      @default(false)
  matchedKeywords String[]
  missedKeywords  String[]
  gradingFeedback String

  @@index([attemptId])
  @@index([questionId])
}
